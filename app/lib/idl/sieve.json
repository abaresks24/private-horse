            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "epoch",
            "docs": [
              "Monotonic epoch (must be strictly greater than the stored epoch)."
            ],
            "type": "u64"
          },
          {
            "name": "clean_count",
            "docs": [
              "Number of clean deposits in the set at this epoch (for the UI / sanity, not trust-bearing)."
            ],
            "type": "u64"
          }
        ]
      }
    },
